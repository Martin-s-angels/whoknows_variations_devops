<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>¿Who Knows?</title>
  <link rel="stylesheet" type="text/css" href="/style/style.css">
</head>

<body>
  <nav class="navigation">
    <h1><a id="nav-logo" href="/">¿Martin's Angels?</a></h1>
    <div>
      <% if locals[:logged_in] %>
        <a id="nav-logout" href="/api/logout">Log out</a>
      <% else %>
        <a id="nav-login" href="/login">Log in</a>
        <a id="nav-register" href="/register">Register</a>
      <% end %>
    </div>
  </nav>

  <!-- use flashes to send messages to users -->
  <% if flash.keys.any? %>
    <ul class="flashes">
      <% flash.keys.each do |type| %>
        <li class="<%= type %>"> <%= flash[type] %> </li>
      <% end %>
    </ul>
  <% end %>

  <main class="body">
    <%= yield %> <!-- display render page -->
  </main>

  <!-- footer -->
  <footer class="footer">
    <span>¿Who Knows? &copy; 2009-2025</span>
    <a href="/about">About</a>
  </footer>

</body>
</html>