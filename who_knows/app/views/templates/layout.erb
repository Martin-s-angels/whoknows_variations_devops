  {% if flashes %}
  <ul class="flashes">
    {% for message in flashes %}
    <li>{{ message }}
      {% endfor %}
  </ul>
  {% endif %}
  {% endwith %}
  -->

  <div class="body">
    <!--{% block body %}{% endblock %} --><!-- legacy -->
    <%= yield %> <!-- display render page -->

  </div>

  <!-- footer -->
  <div class="footer">
    <span>¿Who Knows? &copy; 2009-2025</span>
    <a href="about.erb">About</a>
  </div>
</div>

</body>
</html>